{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["packages/*/src/**/*.ts", "packages/core/test/**/*.ts", "demo/app.ts"]
}
